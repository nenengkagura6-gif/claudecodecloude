# Salin file ini menjadi ".env" lalu isi kunci yang dipakai saja.
# File .env TIDAK ikut ter-commit (lihat .gitignore).

# Anthropic (default provider)
ANTHROPIC_API_KEY=

# OpenAI / kompatibel (LM Studio, vLLM, OpenRouter, dsb.)
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Ollama (lokal) biasanya tidak butuh kunci.
# OLLAMA_HOST=http://localhost:11434

# Token sederhana untuk webhook /clip (dipakai n8n)
TUKANG_SAYUR_TOKEN=
